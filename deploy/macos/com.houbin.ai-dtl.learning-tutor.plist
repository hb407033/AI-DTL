<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  mini 上的开机配置（2026-10-25 起）。不放在 ~/Documents、不用 Homebrew 的 node：
  - launchd 启动的进程读不了 ~/Documents（TCC，开机后报 Operation not permitted，退出码 126）；
  - Homebrew 升级会换掉 node 依赖的动态库（2026-10-25 simdjson 升级后 node 26 起不来）。
  所以用 nvm 固定的 node v22.22.3，直接跑 Application Support 里已核对过的独立部署包，
  .env.ai.local 复制到 Application Support（权限 600）。换版本时只改第三个参数的包路径。
-->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.houbin.ai-dtl.learning-tutor</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/hb-mini/.nvm/versions/node/v22.22.3/bin/node</string>
        <string>--env-file-if-exists=/Users/hb-mini/Library/Application Support/ai-dtl/.env.ai.local</string>
        <string>/Users/hb-mini/Library/Application Support/ai-dtl/runtime/2026-11-08-teaching-v16/learning-tutor-teaching-v16.mjs</string>
    </array>
    <key>WorkingDirectory</key><string>/Users/hb-mini/Library/Application Support/ai-dtl</string>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>10</integer>
    <key>StandardOutPath</key><string>/Users/hb-mini/Library/Logs/ai-dtl/learning-tutor.out.log</string>
    <key>StandardErrorPath</key><string>/Users/hb-mini/Library/Logs/ai-dtl/learning-tutor.err.log</string>
</dict>
</plist>
