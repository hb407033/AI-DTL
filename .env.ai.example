# 复制为 .env.ai.local 后只在本机编辑。不要把新 Key 发到聊天中。
# 当前仅检查配置/准备客户端；填写不会自动启动云端语音。
DASHSCOPE_API_KEY=
AI_DTL_QWEN_WORKSPACE_ID=
# 决策通道：realtime（默认，实时语音模型）或 thinking（思考模型，延迟更高但带分析）
AI_DTL_DECISION_MODE=realtime
# Pi 与千问语音是独立配置；此处填写 Pi 中已开通的精确 provider/model。
AI_DTL_PI_PROVIDER=
AI_DTL_PI_MODEL=
AI_DTL_PI_COMMAND=pi
