{
  "name": "ai-scholar-learning-system",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present typecheck",
    "gate:server": "pnpm --filter @ai-scholar/gate-server start",
    "gate:codex": "pnpm --filter @ai-scholar/codex-realtime-probe start",
    "gate:report": "pnpm --filter @ai-scholar/gate-report start",
    "host": "pnpm --filter @ai-scholar/agent-host start",
    "ai:check": "node --env-file-if-exists=.env.ai.local --import tsx apps/agent-host/src/ai/check.ts",
    "host:simple": "node --env-file-if-exists=.env.ai.local --import tsx apps/agent-host/src/ai/simple-tutor.ts",
    "host:learning": "node --env-file-if-exists=.env.ai.local --import tsx apps/agent-host/src/ai/learning-tutor.ts",
    "probe:qwen-capability": "node --env-file-if-exists=.env.ai.local --import tsx apps/agent-host/src/ai/qwen-capability-probe.ts",
    "host:pi": "node --env-file-if-exists=.env.ai.local --import tsx apps/agent-host/src/server.ts --pi",
    "session:replay": "pnpm --filter @ai-scholar/agent-host replay"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
